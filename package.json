{
  "name": "localpix",
  "version": "1.0.0",
  "description": "Local, offline image converter — batch-convert between JPEG, PNG, WebP, AVIF, GIF, TIFF, BMP, ICO and more.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --mac"
  },
  "dependencies": {
    "ag-psd": "^25.0.0",
    "bmp-js": "^0.1.0",
    "express": "^4.18.2",
    "heic-decode": "^2.1.0",
    "multer": "^2.1.1",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0"
  },
  "overrides": {
    "picomatch": "^4.0.4"
  },
  "build": {
    "appId": "com.local.localpix",
    "productName": "LocalPix",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server.js",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/libheif-js/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    }
  }
}
